# Reserved for the server adapter. Live interview/event requests need META_AI_ENABLED=true
# plus MODEL_API_KEY. Anything else (including false or missing values) stays on mocks.
# Transcription keeps its own META_TRANSCRIPTION_ENABLED flag. Video planning stays mock-only.
MODEL_API_KEY=
META_AI_ENABLED=false
META_TRANSCRIPTION_ENABLED=false

# Image generation follows META_AI_ENABLED unless explicitly disabled here.
# It runs only after clicking a scene's Generate with Meta button.
META_IMAGE_ENABLED=true
