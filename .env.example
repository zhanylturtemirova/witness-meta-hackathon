# Local development. Anything unset or false stays on local mocks.
MODEL_API_KEY=
META_AI_ENABLED=false
META_TRANSCRIPTION_ENABLED=false

# Image generation follows META_AI_ENABLED unless explicitly disabled here.
# It runs only after clicking a scene's Generate with Meta button.
META_IMAGE_ENABLED=true

# Local server bind. Keep the loopback default for development.
HOST=127.0.0.1
PORT=4173

# Public deployment. Setting PUBLIC_ORIGIN switches the server to hosted
# mode: API routes require that host, paid Meta endpoints require a
# server-verified Supabase session, and mocks are never served.
# Example: PUBLIC_ORIGIN=https://witness.onrender.com
PUBLIC_ORIGIN=

# Supabase project for hosted sign-in (public values; the server uses them
# only to verify session tokens, never to bypass row-level security).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Paid-request guards (hosted and local). Restarts reset the counters.
AI_USER_HOURLY_LIMIT=60
AI_MAX_CONCURRENT=1
AI_GENERATION_CAP=1000
